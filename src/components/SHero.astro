---
---

<div class="s-hero" data-intersect>
  <!-- The oversized marquee scrolls out through the top of the viewport
       with a hard, unblurred cut (Hero's own overflow:hidden only clips
       at Hero's box edges, not the viewport edge) right as WORK's own
       blurred entrance is happening below. Genuinely position:fixed to
       the viewport (not confined via a containing-block trick like
       .s__seam-blur in SWork.astro) so the browser can composite it on
       the cheap, scroll-independent fast path — confining it via
       clip-path/transform on an ancestor was tried first, but that
       forces the browser to recompute its screen position against that
       (scrolling) ancestor on every scroll frame instead, which lagged
       a frame or two behind during fast/inertial scroll and let the
       hard cut flash through. Hidden once Hero has fully scrolled out
       of view via the existing is-out-of-view class (see .s-hero below)
       so it doesn't linger as a bar over WORK afterwards. -->
  <div class="s__top-fade" aria-hidden="true"></div>

  <div class="s__content js-content">
    <h1 class="u-sr-only">Spazio Desk — Studio Collettivo Creativo</h1>

    <div class="s__marquee" aria-hidden="true">
      <div class="s__marquee__track">
        <span class="s__marquee__item"><span class="s__marquee__item__word">SPAZIO</span><span class="s__marquee__item__word">DESK</span></span>
        <span class="s__marquee__item"><span class="s__marquee__item__word">SPAZIO</span><span class="s__marquee__item__word">DESK</span></span>
        <span class="s__marquee__item"><span class="s__marquee__item__word">SPAZIO</span><span class="s__marquee__item__word">DESK</span></span>
        <span class="s__marquee__item"><span class="s__marquee__item__word">SPAZIO</span><span class="s__marquee__item__word">DESK</span></span>
      </div>
    </div>

    <!-- Mobile only: SPAZIO and DESK scroll independently, in opposite
         directions, instead of sliding together as one combined line. -->
    <div class="s__marquee-mobile" aria-hidden="true">
      <div class="s__marquee-mobile__row s__marquee-mobile__row--spazio">
        <div class="s__marquee-mobile__track">
          <span class="s__marquee-mobile__word">SPAZIO</span>
          <span class="s__marquee-mobile__word">SPAZIO</span>
          <span class="s__marquee-mobile__word">SPAZIO</span>
          <span class="s__marquee-mobile__word">SPAZIO</span>
        </div>
      </div>
      <div class="s__marquee-mobile__row s__marquee-mobile__row--desk">
        <div class="s__marquee-mobile__track">
          <span class="s__marquee-mobile__word">DESK</span>
          <span class="s__marquee-mobile__word">DESK</span>
          <span class="s__marquee-mobile__word">DESK</span>
          <span class="s__marquee-mobile__word">DESK</span>
        </div>
      </div>
    </div>
  </div>

  <div class="s__border js-border"></div>
</div><!-- .s-hero -->

<script>
  import Emitter from '../utils/Emitter'

  import { gsap } from 'gsap'

  class Section {
    el: HTMLElement

    constructor() {
      this.el = document.querySelector('.s-hero')

      if (document.readyState === 'complete') {
        this.init()
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    init() {
      document.addEventListener('intro', this.intro.bind(this), { once: true })
    }

    intro() {
      const content = this.el.querySelector('.js-content')
      const border = this.el.querySelector('.js-border')
      const separators = content.querySelectorAll('.js-separator')

      const tl = gsap.timeline()

      tl.set(this.el, { opacity: 1 }, 0)

      tl.to(
        border,
        { scaleY: 0.025, y: -content.clientHeight, duration: 1, ease: 'expo.inOut' },
        0
      )

      tl.fromTo(
        content,
        { clipPath: 'polygon(0 0, 100% 0, 100% 0, 0 0)' },
        { clipPath: 'polygon(0 0, 100% 0, 100% 100%, 0 100%)', duration: 1, ease: 'expo.inOut' },
        1
      )

      // Instant on purpose, not animated: while this settles back to its
      // resting position (invisible, clipped below Hero by
      // overflow:hidden), any non-zero duration passes it through
      // Hero's own visible area mid-transition. Scrolling unblocks as
      // soon as 'intro' fires (this tl's position 0), so a fast scroll/
      // hash-jump into WORK right after could catch a still-animating
      // tween here, flashing the border across the Hero/WORK seam. This
      // step has no visible purpose of its own (attention is on
      // content's own reveal, happening at the same position) — only
      // its end state (fully reset, off-screen) matters.
      tl.set(
        border,
        { scaleY: 1, y: 0 },
        1
      )

      tl.from(
        separators,
        {
          y: (index) => (index % 2 === 0 ? '-100%' : '100%'),
          duration: 1.5,
          ease: 'expo.inOut',
        },
        0.75
      )
    }
  }

  new Section()
</script>

<style lang="scss">
  .s-hero {
    @include flex(column, stretch, center);

    position: relative;
    z-index: 4;

    min-height: calc(100svh - 7rem);

    opacity: 1;
    overflow: hidden;

    @include mq(phone) {
      min-height: calc(100svh - 4.5rem);
    }

    .s__border {
      position: absolute;
      top: 100%;
      left: 0;

      width: 100%;
      height: 40 * 1rem;

      background: color(secondary);
      transform-origin: 50% 0;

      @include mq(phone) {
        height: 40 * 0.5rem;
      }
    }

    .s__top-fade {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 5;

      width: 100%;
      height: 8rem;

      background: linear-gradient(to bottom, color(primary), transparent);
      filter: blur(1.5rem);

      pointer-events: none;

      transition: opacity 0.2s linear;

      @include mq(phone) {
        height: 4rem;
      }
    }

    &.is-out-of-view .s__top-fade {
      opacity: 0;
    }

    .s__content {
      position: relative;

      overflow: hidden;
      transform-origin: 50% 100%;

    }

    .s__marquee {
      overflow: hidden;
      width: 100%;

      @include mq(phone) {
        display: none;
      }

      &__track {
        display: flex;
        width: max-content;

        will-change: transform;
        animation: s-hero-marquee 35s linear infinite;
      }

      &__item {
        display: flex;
        align-items: baseline;

        font: 700 clamp(9.44rem, 40.89vw, 58.2rem) / 1 'Helvetica Neue', Helvetica, Arial, sans-serif;
        text-transform: uppercase;
        letter-spacing: -4px;
        white-space: nowrap;
        color: color(secondary);

        padding: 1.5rem 1.5em 1.5rem 0;
        flex-shrink: 0;

        @include mq(tablet) {
          padding-top: 1rem;
          padding-bottom: 1rem;
        }

        &__word:first-child {
          margin-right: 0.2em;
        }
      }
    }

    // Mobile-only replacement for .s__marquee: SPAZIO and DESK each get
    // their own full-width row and scroll independently in opposite
    // directions, rather than sliding together as one combined line.
    .s__marquee-mobile {
      display: none;

      @include mq(phone) {
        display: block;
      }

      &__row {
        display: flex;
        justify-content: center;

        overflow: hidden;
        width: 100%;

        &--desk {
          .s__marquee-mobile__track {
            animation-direction: reverse;
          }
        }
      }

      &__track {
        display: flex;
        width: max-content;

        will-change: transform;
        animation: s-hero-marquee 35s linear infinite;
      }

      &__word {
        font: 700 clamp(11rem, 48vw, 22rem) / 1 'Helvetica Neue', Helvetica, Arial, sans-serif;
        text-transform: uppercase;
        letter-spacing: -4px;
        white-space: nowrap;
        color: color(secondary);

        padding: 0.75rem 0.5em 0.75rem 0;
        flex-shrink: 0;
      }
    }

    @keyframes s-hero-marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-25%); }
    }
  }
</style>
