---
import AWork from './AWork.astro'

// `width` and `height` are the full-size file's own dimensions (they
// size the window); `smaller` lists the widths of its downscaled copies
// in /public/works (name-960.mp4, ...). Each device loads the smallest
// one that is still sharp at the size it shows the window.
const works = [
  { caption: "La Terrazza dell'Orologio", site: '#', src: '/works/terrazza.mp4',  width: 1280, height: 842, smaller: [960] },
  { caption: 'Hyper Studio',      site: '#', src: '/works/frame_186.mp4', width: 1920, height: 1262, smaller: [960, 1280] },
  { caption: 'Formaggi in Festa', site: '#', src: '/works/frame_185.mp4', width: 1920, height: 1262, smaller: [960, 1280] },
  { caption: 'CPS Ragusa',        site: '#', src: '/works/frame_183.mp4', width: 1920, height: 1262, smaller: [960, 1280] },
  { caption: 'MONTEROSSO SOUND FESTIVAL', site: '#', src: '/works/monterosso.mp4', width: 1920, height: 1262, smaller: [960, 1280] },
]
---

<section id="work" class="s-work" data-intersect>
  <div class="s__outer">
    <div class="s__inner js-container">
      <h2 class="s__title">
        <span class="s__title__inner js-title">
          <span class="s__title__letter js-letter">W</span>
          <span class="s__title__letter js-letter">O</span>
          <span class="s__title__letter js-letter">R</span>
          <span class="s__title__letter js-letter">K</span>
        </span>
      </h2>

      <div class="s__scene js-scene">
        {
          works.map((work, index) => (
            <AWork
              cssClass="s__scene__work s__scene__work--video js-work"
              caption={work.caption}
              site={work.site}
              src={work.src}
              width={work.width}
              height={work.height}
              smaller={work.smaller}
              index={String(index).padStart(4, '0')}
              total="26"
            />
          ))
        }
      </div><!-- .s__scene -->
    </div><!-- .s__inner -->

    <div class="s__mask-outer">
      <div class="s__mask js-mask">
        <div class="s__video-bg js-video-bg">
          <video
            class="js-video-bg-video"
            src="/works/visual-bg.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
          ></video>
        </div>
        <svg class="s__mask__svg js-mask-svg">
          <path class="s__mask__path-inner js-mask-path-inner" d=""></path>
          <path class="s__mask__path-outer js-mask-path-outer" d=""></path>
        </svg>
      </div><!-- .s__mask -->
    </div><!-- .s__mask-outer -->

    <div class="s__ruler js-ruler"></div>
  </div><!-- .s__outer -->

  <!--
    .s__outer's clip-path makes it a containing block for its own fixed
    descendants (.s__inner, .s__mask-outer's video mask) — but that also
    means anything positioned inside it gets clipped to .s__outer's own
    box, whatever its transform. The hard cut always sits exactly at
    .s__outer's (== .s-work's) top edge as it scrolls through the
    viewport, regardless of which layer (.s__inner's panel or the video
    mask) is visible there. So this lives OUTSIDE .s__outer, as a plain
    absolutely-positioned sibling pinned to .s-work's top — it tracks
    that edge automatically with scroll, no transform math needed.
  -->
  <div class="s__seam-blur" aria-hidden="true"></div>
</section>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'

  import { gsap } from 'gsap'
  import { SlowMo } from 'gsap/EasePack'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger, SlowMo)

  // How many work videos are allowed to load (fetch + decode) at once.
  // Loading all of them fully in parallel risked losing the race for a
  // browser's limited concurrent video decoder slots on some devices.
  const VIDEO_LOAD_CONCURRENCY = 2

  // Section height, in lvh: see setSize(). The timeline lasts
  // 1.75 + 0.25 per window (in its own seconds) and is scrubbed over the
  // section's height minus 75lvh, at 900/13 lvh per timeline second.
  const SCROLL_PER_WORK_LVH = 225 / 13
  const SCROLL_BASE_LVH = 75 + (1.75 * 900) / 13

  // Size the windows are shown at, relative to their laid-out box
  const WORK_SCALE = 0.75

  const round = (value: number) => Math.round(value * 1e5) / 1e5
  const clamp01 = (value: number) => Math.min(Math.max(value, 0), 1)

  class Section {
    el: HTMLElement
    container: HTMLElement
    videoBg: HTMLElement | null
    bgVideo: HTMLVideoElement | null
    ruler: HTMLElement
    scene: HTMLElement
    title: HTMLElement

    mask: {
      width: number
      height: number
      maxScale: number
      coverState: number
      el: HTMLElement
      svg: HTMLElement
      pathOuter: HTMLElement
      pathInner: HTMLElement
    }

    bounding: {
      left: number
      top: number
      width: number
      height: number
    }
    letters: any[]
    works: any[]

    tl: gsap.core.Timeline
    animationProgress: number
    state: number
    speed: number
    spread: number
    shift: number

    // The section's place on the page, kept from the last measurement so
    // scrolling never has to read it back from the DOM
    top: number
    height: number

    scrollProgress: number
    isInView: boolean
    isCovered: boolean

    lettersState: number
    lettersProgress: number

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-work')
      this.container = this.el.querySelector('.js-container')
      this.ruler = this.el.querySelector('.js-ruler')
      this.scene = this.container.querySelector('.js-scene')
      this.title = this.container.querySelector('.js-title')

      // Properties
      this.videoBg = this.el.querySelector('.js-video-bg')
      this.bgVideo = this.el.querySelector('.js-video-bg-video')

      this.mask = {
        width: 0,
        height: 0,
        maxScale: 1,
        coverState: Infinity,
        el: this.el.querySelector('.js-mask'),
        svg: this.el.querySelector('.js-mask-svg'),
        pathOuter: this.el.querySelector('.js-mask-path-outer'),
        pathInner: this.el.querySelector('.js-mask-path-inner'),
      }

      this.letters = []
      this.title.querySelectorAll('.js-letter').forEach((_letter) => {
        const letter = {
          el: _letter,
          ghosts: [],
        }

        this.letters.push(letter)
      })

      this.works = []
      this.container.querySelectorAll('.js-work').forEach((_work) => {
        const work = {
          el: _work,
        }

        this.works.push(work)
      })

      this.top = 0
      this.height = 0

      this.state = 0
      this.animationProgress = 0
      this.scrollProgress = 0

      this.isInView = false
      this.isCovered = false

      // Init
      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    /**
     * Init
     */
    init() {
      this.setSize()
      this.setMask()
      this.setLetters()
      this.setWorks()
      this.setTimeline()

      this.bindEvents()

      // The windows place and load themselves, from their own script
      // (AWork). Should it ever arrive after this one, they get their
      // layout and start loading when it does.
      if (!customElements.get('a-work')) {
        customElements.whenDefined('a-work').then(() => {
          this.setWorks()
          this.loadNextVideo()
        })
      }

      // Start loading videos immediately regardless of scroll position
      this.loadNextVideo()

      // The section may already be in view (refresh mid-page)
      this.onScroll(window.scrollY)
      this.updateBackground()

      ScrollTrigger.refresh()
    }

    /**
     * Bind events
     */
    bindEvents() {
      Emitter.on('resize', this.onResize, this)
      Emitter.on('scroll', this.onScroll, this)

      // What moves the section on the page without a resize: anything
      // ending in a ScrollTrigger refresh, and whatever changes the
      // page's height (reported here by the browser once it has laid
      // the page out again, so reading the position back is free)
      ScrollTrigger.addEventListener('refresh', () => this.measure())

      new ResizeObserver(() => {
        this.measure()
        this.onScroll(window.scrollY)
      }).observe(document.body)

      document.addEventListener('intro', () => {
        this.el.style.opacity = '1'
        ScrollTrigger.refresh()
      }, { once: true })

      this.el.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })

      this.works.forEach((work) => {
        work.el.addEventListener('loaded', () => this.loadNextVideo())
      })
    }

    /**
     * Resize handler
     */
    onResize(widthChanged) {
      if (widthChanged) {
        this.setSize()
        this.setMask()
        this.setLetters()
        this.setWorks()
        this.setTimeline()

        this.works.forEach((work) => work.el.refreshSource?.())

        // setTimeline() tears down and rebuilds this section's own
        // ScrollTrigger, but other pinned/triggered sections on the page
        // can be left with stale bounds after a width change (e.g. a
        // DevTools panel opening/closing) unless every ScrollTrigger is
        // recalculated together.
        ScrollTrigger.refresh()
      } else {
        const { height } = this

        this.measure()

        // The section is sized in lvh, so a phone's address bar sliding
        // away or back leaves it alone (and Site no longer refreshes
        // ScrollTrigger for that). Whatever does resize it moves the
        // scroll positions its animation is tied to.
        if (this.height !== height) ScrollTrigger.refresh()
      }

      this.onScroll(window.scrollY)
    }

    /**
     * Intersect handler
     */
    onIntersect(e) {
      // Layout is fresh at this point, so reading it back costs nothing
      this.measure()

      this.setInView(e.detail.isIntersecting)
    }

    /**
     * Scroll handler
     *
     * Works from the section's measured position and the scroll offset
     * it is handed, without reading layout: a read here, in the middle
     * of a frame the scroll animation has already written to, would
     * make the browser resolve every pending style change on the spot
     * and again at the end of the frame.
     */
    onScroll(scrollY: number) {
      const viewport = window.safeHeight
      const top = this.top - scrollY
      const bottom = top + this.height

      this.setInView(top < viewport && bottom > 0)

      // -1 → 0 while the section scrolls in from below, 0 while it
      // fills the viewport, 0 → 1 while it leaves at the top
      const scrollProgress =
        1 - clamp01(top / viewport) - clamp01(bottom / viewport)

      if (scrollProgress !== this.scrollProgress) {
        this.scrollProgress = scrollProgress

        this.shiftPanel()
      }
    }

    /**
     * Shift the panel with the section's way in and out of the viewport
     * (not on phones, where the stylesheet sets the amount to 0)
     */
    shiftPanel() {
      const { container, shift, scrollProgress } = this

      container.style.transform = shift
        ? `translate3d(0, ${round(scrollProgress * -shift)}%, 0)`
        : ''
    }

    /**
     * Measure where the section sits on the page
     */
    measure() {
      const rect = this.el.getBoundingClientRect()

      this.top = rect.top + window.scrollY
      this.height = rect.height
    }

    /**
     * Set whether any of the section is on screen
     */
    setInView(isInView: boolean) {
      if (isInView === this.isInView) return

      this.isInView = isInView

      this.updateBackground()
    }

    /**
     * Only draw and decode the mask's background video while it shows.
     *
     * Once the mask has opened far enough for its hole to cover the
     * whole viewport (the windows' turn), the video is entirely outside
     * the screen, yet it was still being decoded and composited through
     * its cut-out every frame. Opacity 0 on the mask (with will-change,
     * see the stylesheet) takes the video and its cut-out out of the
     * compositor's work while keeping their layers ready for the way
     * back; visibility or display would throw them away and rebuild
     * them mid-zoom.
     */
    updateBackground() {
      const { mask, bgVideo } = this

      mask.el.style.opacity = this.isCovered ? '0' : ''

      if (!bgVideo) return

      if (this.isInView && !this.isCovered) {
        const playing = bgVideo.play()
        if (playing) playing.catch(() => {})
      } else {
        bgVideo.pause()
      }
    }

    /**
     * Set size
     */
    setSize() {
      // A fixed share for the mask opening/closing plus the same slice
      // of scroll for every window. With one flat amount per window
      // (as before) the fixed opening/closing got squeezed or stretched
      // along with the window count, so adding or removing a window
      // changed how fast everything else scrolled by.
      this.el.style.setProperty(
        '--height',
        SCROLL_BASE_LVH + this.works.length * SCROLL_PER_WORK_LVH + 'lvh'
      )

      const bounding = this.container.getBoundingClientRect()

      this.bounding = {
        left: bounding.left,
        top: bounding.top,
        width: window.safeWidth,
        height: window.safeHeight,
      }

      this.speed = Math.hypot(this.bounding.width, this.bounding.height) * 4

      // Set per breakpoint in the stylesheet: how far the ghost letters
      // fan out sideways (in vw), and how far the panel shifts as the
      // section scrolls in and out (in % of its height)
      this.spread =
        parseFloat(getComputedStyle(this.scene).getPropertyValue('--spread')) ||
        50

      const shift = parseFloat(
        getComputedStyle(this.container).getPropertyValue('--shift')
      )
      this.shift = Number.isNaN(shift) ? 15 : shift

      this.measure()
      this.shiftPanel()
    }

    /**
     * Set mask
     */
    setMask() {
      const { mask } = this

      // mask.el's scale is actively driven by the scroll-scrubbed
      // timeline (from 1 up to mask.maxScale and back, as the mask
      // opens/closes) via its transform (GSAP writes scale() into
      // style.transform here, not the standalone CSS scale property).
      // Measuring its on-screen geometry while resize handling happens
      // to run mid-scale (e.g. a viewport resize triggered mid-scroll)
      // would bake a wildly wrong offset/shape into the mask SVG paths
      // — neutralize it for these measurements and restore it right
      // after; the resize's later setTimeline() call rebuilds the
      // timeline and syncs it back to the correct scale for the
      // current scroll position anyway.
      const previousTransform = mask.el.style.transform
      mask.el.style.transform = 'none'

      const width = mask.el.clientWidth
      const height = mask.el.clientHeight

      mask.width = width
      mask.height = height

      mask.svg.style.width = mask.width + 'px'
      mask.svg.style.height = mask.height + 'px'

      const elBounding = this.el.getBoundingClientRect()
      const maskBounding = mask.el.getBoundingClientRect()
      const rulerBounding = this.ruler.getBoundingClientRect()
      const rulerWidth = rulerBounding.width
      const rulerHeight = rulerBounding.height
      const offsetX = rulerBounding.left - maskBounding.left
      const offsetY = rulerBounding.top - elBounding.top

      mask.el.style.transform = previousTransform

      // Shape
      const dOuter = `M -1 0 L ${width + 2} 0 L ${width + 2} ${height} L -1 ${height} Z`

      // Mask outer
      const corners = {
        tl: { x: offsetX, y: offsetY },
        tr: { x: offsetX + rulerWidth, y: offsetY },
        br: { x: offsetX + rulerWidth, y: offsetY + rulerHeight },
        bl: { x: offsetX, y: offsetY + rulerHeight },
      }

      const halfWidth = (corners.tr.x - corners.tl.x) / 2
      const r = 36

      mask.maxScale = window.safeWidth / halfWidth

      // The mask scales from its centre, as 1 + (maxScale - 1) * state.
      // From this scale on, the hole's straight edges (its rounded
      // corners left out, to stay on the safe side) are past all four
      // edges of the mask's own box, i.e. nothing of the video is left
      // on screen: see updateBackground().
      const centerX = width / 2
      const centerY = height / 2
      const reach = [
        [centerX, centerX - corners.tl.x - r],
        [width - centerX, corners.tr.x - r - centerX],
        [centerY, centerY - corners.tl.y - r],
        [height - centerY, corners.bl.y - r - centerY],
      ]
      const coverScale = reach.every(([, hole]) => hole > 0)
        ? Math.max(...reach.map(([box, hole]) => box / hole))
        : Infinity

      mask.coverState =
        coverScale <= mask.maxScale
          ? (coverScale - 1) / (mask.maxScale - 1)
          : Infinity

      const rect = (c, rad) => `M ${c.tl.x + rad} ${c.tl.y} L ${c.tr.x - rad} ${c.tr.y} A ${rad} ${rad} 0 0 1 ${c.tr.x} ${c.tr.y + rad} L ${c.br.x} ${c.br.y - rad} A ${rad} ${rad} 0 0 1 ${c.br.x - rad} ${c.br.y} L ${c.bl.x + rad} ${c.bl.y} A ${rad} ${rad} 0 0 1 ${c.bl.x} ${c.bl.y - rad} L ${c.tl.x} ${c.tl.y + rad} A ${rad} ${rad} 0 0 1 ${c.tl.x + rad} ${c.tl.y} Z`

      let dInner = rect(corners, r)
      const linesClip = `${dOuter} ${dInner}`

      if (this.videoBg) {
        this.videoBg.style.clipPath = `path(evenodd, '${linesClip}')`
      }

      mask.pathOuter.setAttribute('d', `${dOuter} ${dInner}`)

      // Mask inner
      const thickness = window.safeWidth > 767 ? 16 : 8
      corners.tl.x += thickness
      corners.tl.y += thickness

      corners.tr.x -= thickness
      corners.tr.y += thickness

      corners.br.x -= thickness
      corners.br.y -= thickness

      corners.bl.x += thickness
      corners.bl.y -= thickness

      dInner = rect(corners, r)

      mask.pathInner.setAttribute('d', `${dOuter} ${dInner}`)

    }

    /**
     * Set letters
     */
    setLetters() {
      const { letters, scene } = this

      letters.forEach((letter, j) => {
        letter.ghosts.forEach((ghost) => {
          ghost.el.remove()
        })
        letter.ghosts = []

        // Get letter position and size
        const bounding = letter.el.getBoundingClientRect()

        letter.width = bounding.width
        letter.height = bounding.height
        letter.top = bounding.top - this.bounding.top
        // Compute explicit center-aligned X so ghost spread is symmetric on all screen sizes.
        // bounding.left can be off for wide letters (e.g. W) that overflow the 0.7em container.
        letter.left = (window.safeWidth - bounding.width) / 2

        letter.freq = 1

        const multiplier = 0.75

        // Create ghost letters
        letter.total =
          Math.round((this.bounding.width / letter.width) * multiplier) + 2

        for (let i = 0; i < letter.total; i++) {
          const el = document.createElement('span')
          el.classList.add('s__scene__letter')
          el.classList.add('js-letter')

          el.innerText = letter.el.innerText
          el.dataset.letter = letter.el.innerText

          scene.appendChild(el)

          const ghost = {
            el,
            x: letter.left,
            y: letter.top,
            // How far up or down this letter's ghosts drift as they
            // spread: -1 (top letter) to 1 (bottom letter)
            iy: ((j + 1) / (letters.length + 1) - 0.5) * 2,
          }

          el.style.top = ghost.y + 'px'
          el.style.left = ghost.x + 'px'

          el.style.zIndex = '1'

          letter.ghosts.push(ghost)
        }
      })

      // The new ghosts start unplaced: make the next render place them
      this.lettersState = NaN
    }

    /**
     * Set works
     */
    setWorks() {
      const { works } = this

      works.forEach((work, i) => {
        // Same size for every window (was randomized 0.5-1 before),
        // alternately above and below the centre line
        work.el.setLayout?.(
          (0.5 + Math.random() * 0.5) * (i % 2 ? -1 : 1),
          WORK_SCALE
        )
      })
    }

    /**
     * Set timeline
     */
    setTimeline() {
      const { el, container, works, scene, mask } = this

      const worksEl = works.map((work) => work.el)

      let { tl } = this

      if (tl) {
        tl.kill()
      }

      tl = gsap.timeline({
        scrollTrigger: {
          trigger: el,
          start: 'top top',
          end: 'bottom 75%',
          scrub: 1,
        },
        onUpdate: () => {
          this.render()
        },
      })

      this.tl = tl

      tl.fromTo(
        mask.el,
        {
          scale: 1,
        },
        {
          scale: mask.maxScale,
          duration: 0.75,
          ease: 'power4.in',
        },
        0
      )

      tl.fromTo(
        scene,
        {
          scale: 0.75,
        },
        {
          scale: 1,
          duration: 0.75,
          ease: 'power3.in',
        },
        0
      )

      tl.fromTo(
        container,
        {
          clipPath: 'inset(0 0rem)',
        },
        {
          clipPath: 'inset(0 0rem)',
          duration: 0.75,
          ease: 'power3.in',
        },
        0
      )

      tl.fromTo(
        this,
        {
          state: 0,
        },
        {
          state: 1,
          duration: 0.75,
          ease: 'power4.in',
        },
        0
      )

      tl.fromTo(
        worksEl,
        {
          attr: {
            progress: 1,
          },
        },
        {
          attr: {
            progress: -1,
          },
          ease: 'slow(0.15, 0.6)',
          stagger: 0.25,
        },
        0.75
      )

      tl.fromTo(
        this,
        {
          animationProgress: 0,
        },
        {
          animationProgress: 10000,
          duration: tl.totalDuration(),
          ease: 'power1.out',
        },
        0.75
      )

      tl.fromTo(
        this,
        {
          state: 1,
        },
        {
          state: 0,
          duration: 0.75,
          ease: 'power4.inOut',
          immediateRender: false,
        },
        '-=1.25'
      )

      tl.fromTo(
        mask.el,
        {
          scale: mask.maxScale,
        },
        {
          scale: 1,
          duration: 0.75,
          ease: 'power4.inOut',
          immediateRender: false,
        },
        '-=1.25'
      )

      tl.fromTo(
        scene,
        {
          scale: 1,
        },
        {
          scale: 0.75,
          duration: 0.75,
          ease: 'power3.inOut',
          immediateRender: false,
        },
        '-=1.25'
      )

      tl.fromTo(
        container,
        {
          clipPath: 'inset(0 0rem)',
        },
        {
          clipPath: 'inset(0 1rem)',
          duration: 0.75,
          ease: 'power3.inOut',
          immediateRender: false,
        },
        '-=1.25'
      )

      this.render()
    }

    /**
     * Bring everything the timeline does not tween by itself in line
     * with it: runs whenever the timeline moves, not every frame
     */
    render() {
      const isCovered = this.state >= this.mask.coverState

      if (isCovered !== this.isCovered) {
        this.isCovered = isCovered

        this.updateBackground()
      }

      this.moveLetters()
    }

    /**
     * Load next video
     *
     * Loads several work videos at once (up to VIDEO_LOAD_CONCURRENCY)
     * instead of strictly one-at-a-time, so windows have their media
     * ready sooner — but capped, rather than starting every video's
     * fetch/decode simultaneously, which risked losing the race for a
     * browser's limited concurrent video decoder slots on some devices.
     * Each window keeps track of its own loading (see AWork), so one
     * that scrolls into view before its turn can start on its own
     * without being loaded twice.
     */
    loadNextVideo() {
      const works = this.works.map((work) => work.el)

      const loading = works.filter((work) => work.loadState === 'loading').length

      works
        .filter((work) => work.loadState === 'idle')
        .slice(0, Math.max(0, VIDEO_LOAD_CONCURRENCY - loading))
        .forEach((work) => work.load())
    }

    /**
     * Move letters
     *
     * Each ghost's transform is worked out here and written straight to
     * it. It used to come out of custom properties (the spread on the
     * scene, the position on each ghost) feeding a calc() in the
     * stylesheet: every change to the scene's one made the browser
     * re-resolve the styles of every ghost and window inside it, on
     * every frame of the animation, which is what weaker devices could
     * not keep up with.
     */
    moveLetters() {
      const { speed, spread, letters, animationProgress, state } = this

      if (state === this.lettersState && animationProgress === this.lettersProgress) {
        return
      }

      // Closed and already placed: every ghost sits on its letter,
      // wherever it is along its loop
      const isAtRest = state === 0 && this.lettersState === 0

      this.lettersState = state
      this.lettersProgress = animationProgress

      if (isAtRest) return

      letters.forEach((letter) => {
        const letterSpeed = speed * letter.freq
        const loop = (animationProgress % letterSpeed) / letterSpeed

        letter.ghosts.forEach((ghost, index) => {
          const progress = ((loop + index / letter.total) % 1) / 0.7 - 0.15

          // 1 → -1 from one side of the scene to the other
          const head = (progress - 0.5) * -2
          const offset = head * state

          ghost.el.style.transform =
            `rotateY(${round(offset * -10)}deg) ` +
            `translate3d(${round(offset * spread)}vw, ${round(ghost.iy * 50 * head * offset)}%, 0)`
        })
      })
    }
  }

  new Section()
</script>

